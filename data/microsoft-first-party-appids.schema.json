{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Galvnyz/CheckID/data/microsoft-first-party-appids.schema.json",
  "title": "Microsoft First-Party App IDs",
  "description": "Schema for microsoft-first-party-appids.json - canonical allowlist of Microsoft first-party application IDs (AppIds) and owner-tenant GUIDs. Consumers reference it to exclude legitimate Microsoft-published service principals from foreign-app impersonation checks (e.g. ENTRA-ENTAPP-020) and to baseline expected workload identities.",
  "type": "object",
  "required": ["$schema", "version", "lastUpdated", "purpose", "sources", "ownerTenantIds", "appIds"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this JSON Schema file for editor validation."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the allowlist data."
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date (YYYY-MM-DD) the allowlist was last revised."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "What the allowlist is for and which checks consume it."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" },
      "description": "Authoritative references the allowlist is derived from."
    },
    "ownerTenantIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ownerTenant" },
      "description": "Microsoft-owned tenant GUIDs that publish first-party service principals."
    },
    "appIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/appEntry" },
      "description": "Known Microsoft first-party application IDs."
    },
    "calibrationStatus": {
      "type": "string",
      "description": "Short marker of how complete/calibrated the current data is."
    },
    "calibrationNote": {
      "type": "string",
      "description": "Longer note on calibration approach and maintenance."
    }
  },
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "source": {
      "type": "object",
      "required": ["url", "title"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "accessedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    },
    "ownerTenant": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "knownExamples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "appEntry": {
      "type": "object",
      "required": ["appId", "name"],
      "additionalProperties": false,
      "properties": {
        "appId": { "$ref": "#/$defs/guid" },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "ownerTenantHint": { "type": "string" }
      }
    }
  }
}
